# ==============================================================================
# UIMS Docker Ignore File (2026 Best Practices)
# ==============================================================================

# Version control
.git/
.gitignore
.gitattributes
.github/

# Planning & Docs
.planning/
*.md
!README.md
*.txt

# Dependencies & Local Stores
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build artifacts & caches
dist/
dist-*/
dist_*/
build/
out/
.next/
.turbo/
.cache/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache

# Environment & local credentials
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key
certs/

# Logs & temp files
logs/
.pids/
*.log
*.log.*
*.pid
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
lerna-debug.log*
tmp/
temp/
.temp/
.tmp/
scratch/
.scratch/

# Test & Coverage
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
.playwright/
.vitest/
scripts/

# IDE & OS & Agents
.idea/
.vscode/
.claude/
.gemini/
.cursor/
.windsurf/
.copilot/
.antigravity/
.agents/
.planning/
ORIGINAL_REQUEST.md
PROJECT.md
TEST_INFRA.md
TEST_READY.md
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
[Dd]esktop.ini

# Archives & dumps
*.tgz
*.tar.gz
*.zip
*.7z
*.core
*.dump
