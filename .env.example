# ─── Application ────────────────────────────────────────
NODE_ENV=development
APP_NAME=UIMS
APP_PORT=3000
APP_URL=http://localhost:3000

# ─── Database (PostgreSQL) ──────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=uims
DATABASE_PASSWORD=uims_secret_2026
DATABASE_NAME=uims_db
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=uims_redis_2026
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ─── JWT Authentication ────────────────────────────────
JWT_SECRET=uims-jwt-secret-change-in-production
JWT_REFRESH_SECRET=uims-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── MeiliSearch ────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=uims_meili_master_key_2026

# ─── SeaweedFS (S3-compatible) ──────────────────────────
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=uims_s3_access
S3_SECRET_KEY=uims_s3_secret
S3_BUCKET=uims-files
S3_REGION=us-east-1

# ─── Frontend ──────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=UIMS
