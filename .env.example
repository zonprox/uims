# ─── Application ────────────────────────────────────────
NODE_ENV=development
APP_NAME=UIMS
APP_PORT=3000
APP_URL=http://localhost:3000

# ─── Database (PostgreSQL) ──────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=uims
DATABASE_PASSWORD=your_secure_db_password
DATABASE_NAME=uims_db
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ─── JWT Authentication ────────────────────────────────
JWT_SECRET=your_secure_jwt_secret_min_32_characters
JWT_REFRESH_SECRET=your_secure_jwt_refresh_secret_min_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── MeiliSearch ────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key

# ─── SeaweedFS (S3-compatible) ──────────────────────────
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=uims-files
S3_REGION=us-east-1

# ─── Frontend ──────────────────────────────────────────
WEB_PORT=5679
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=UIMS
