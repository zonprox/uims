# ==============================================================================
# UIMS Monorepo .gitignore (2026 Best Practices)
# Architecture: pnpm workspaces + Turborepo + NestJS 11 + React 19 + Prisma 7
# ==============================================================================

# ------------------------------------------------------------------------------
# Package Managers & Dependencies
# ------------------------------------------------------------------------------
node_modules/
node_modules*/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/
.pnp.*
package-lock.json
yarn.lock
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# Build Outputs & Compilation Caches
# ------------------------------------------------------------------------------
dist/
dist-*/
dist_*/
build/
out/
.next/
.nuxt/
.output/
.turbo/
.cache/
.parcel-cache/
.swc/
.tsdown/
.vite/
*.tsbuildinfo
tsconfig.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache

# ------------------------------------------------------------------------------
# Environment, Credentials & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.jwt
certs/
secrets/

# ------------------------------------------------------------------------------
# Logs & Process Telemetry
# ------------------------------------------------------------------------------
logs/
.pids/
*.log
*.log.*
*.pid
*.seed
*.pid.lock
lerna-debug.log*

# ------------------------------------------------------------------------------
# Testing, Coverage & Playwright Reports
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
.playwright/
blob-report/
.vitest/

# ------------------------------------------------------------------------------
# Database & Container Volume Persistence
# ------------------------------------------------------------------------------
docker/data/
data/
*.rdb
*.sqlite
*.sqlite3
*.sqlite-journal
*.sql.gz

# Prisma (Keep migrations, ignore lock/temporary files)
apps/api/prisma/migrations/**/migration_lock.toml

# ------------------------------------------------------------------------------
# IDE, Editors & Development Tools
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*.swn
*~
*.bak
*.orig
*.rej
*.sublime-project
*.sublime-workspace
.claude/
.gemini/
.cursor/
.windsurf/
.copilot/
.antigravity/
.agents/
.planning/
.planning/tmp/
.codebase-memory/
ORIGINAL_REQUEST.md
PROJECT.md
TEST_INFRA.md
TEST_READY.md

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
desktop.ini
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Packaging, Temporary & Scratch Files
# ------------------------------------------------------------------------------
*.tgz
*.tar.gz
*.zip
*.7z
tmp/
temp/
.temp/
.tmp/
scratch/
.scratch/
*.core
*.dump
*.stackdump
