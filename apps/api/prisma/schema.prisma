generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
  LOST
}

enum LicenseType {
  SUBSCRIPTION
  PERPETUAL
  OPEN_SOURCE
  VOLUME
  OEM
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  EXPIRING_SOON
  REVOKED
}

enum IPStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
  SUSPENDED
}

enum DirectorySource {
  LOCAL
  LDAP
  AZURE_AD
}

enum DomainJoinStatus {
  JOINED
  NOT_JOINED
  PENDING
}

enum NotificationType {
  INFO
  WARNING
  ALERT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model AppUser {
  id                 String     @id @default(uuid())
  username           String     @unique
  email              String     @unique
  passwordHash       String
  firstName          String
  lastName           String
  displayName        String?
  avatar             String?
  phone              String?
  roleId             String?
  status             UserStatus @default(ACTIVE)
  isLocked           Boolean    @default(false)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  role          Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status])
  @@index([roleId])
  @@index([email])
  @@index([username])
}

model DirectoryUser {
  id               String          @id @default(uuid())
  employeeCode     String?         @unique
  email            String          @unique
  firstName        String
  lastName         String
  displayName      String?
  phone            String?
  avatar           String?
  managerName      String?
  status           AccountStatus   @default(ACTIVE)
  source           DirectorySource @default(LOCAL)
  accountExpiresAt DateTime?

  // Active Directory Domain Join Metadata
  adDomain         String?
  computerName     String?
  domainJoined     Boolean          @default(false)
  domainJoinStatus DomainJoinStatus @default(NOT_JOINED)

  // Enterprise Email Credentials (Encrypted at rest via AES-256-GCM)
  emailPassword          String?
  emailPasswordUpdatedAt DateTime?

  departmentId     String?
  positionId       String?
  organizationId   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization       Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position           Position?             @relation(fields: [positionId], references: [id], onDelete: SetNull)
  assignedAssets     Asset[]               @relation("DirectoryAssignedAssets")
  licenseAssignments LicenseAssignment[]
  groupMemberships   DirectoryMembership[]
  assignedIPs        IPAddress[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([employeeCode])
  @@index([email])
  @@index([firstName, lastName])
  @@index([managerName])
  @@index([adDomain])
  @@index([computerName])
  @@index([domainJoined])
  @@index([domainJoinStatus])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       AppUser[]
  permissions RolePermission[]
}

model Permission {
  id         String           @id @default(uuid())
  action     String
  subject    String
  conditions Json?
  roles      RolePermission[]

  @@unique([action, subject])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model CostCenter {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]

  @@index([code])
}

model Asset {
  id             String      @id @default(uuid())
  assetCode      String?     @unique
  subcode        String?     @unique
  assetTag       String?     @unique
  parentId       String?
  parent         Asset?      @relation("AssetHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       Asset[]     @relation("AssetHierarchy")
  costCenterId   String?
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  categoryId     String?
  status         AssetStatus @default(AVAILABLE)
  serialNumber   String?
  model          String?
  manufacturer   String?
  specifications String?
  unitCost       Float?
  vendorId       String?
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  assignedToId   String?
  departmentId   String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  category       AssetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo     DirectoryUser?     @relation("DirectoryAssignedAssets", fields: [assignedToId], references: [id], onDelete: SetNull)
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  vendorRef      Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  ipAddresses    IPAddress[]
  networkSwitch  NetworkSwitch?     @relation("SwitchAsset")
  connectedPorts SwitchPort[]       @relation("ConnectedAssetPorts")

  @@index([parentId])
  @@index([costCenterId])
  @@index([assetCode])
  @@index([subcode])
  @@index([assetTag])
  @@index([assignedToId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([vendorId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([warrantyExpiry])
  @@index([name])
  @@index([model])
  @@index([serialNumber])
}

model AssetCategory {
  id          String          @id @default(uuid())
  name        String
  description String?
  parentId    String?
  parent      AssetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    AssetCategory[] @relation("CategoryHierarchy")
  assets      Asset[]

  @@index([parentId])
}

model InventoryCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items InventoryItem[]
}

model InventoryItem {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  categoryId   String
  quantity     Int      @default(0)
  minThreshold Int      @default(5)
  unitCost     Float    @default(0)
  binNumber    String?
  supplier     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([sku])
  @@index([categoryId])
  @@index([quantity])
  @@index([name])
  @@index([supplier])
}

model License {
  id           String        @id @default(uuid())
  name         String
  vendor       String?
  vendorId     String?
  licenseKey   String?
  type         LicenseType   @default(SUBSCRIPTION)
  totalSeats   Int
  usedSeats    Int           @default(0)
  costPerSeat  Float         @default(0)
  purchaseDate DateTime?
  expiryDate   DateTime?
  cost         Float?
  status       LicenseStatus @default(ACTIVE)
  autoRenew    Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vendorRef   Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assignments LicenseAssignment[]

  @@index([status])
  @@index([expiryDate])
  @@index([vendor])
  @@index([vendorId])
  @@index([name])
}

model LicenseAssignment {
  id            String         @id @default(uuid())
  licenseId     String
  userId        String?
  assignedName  String?
  assignedEmail String?
  department    String?
  assignedAt    DateTime       @default(now())
  unassignedAt  DateTime?
  license       License        @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user          DirectoryUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@index([userId])
  @@index([assignedEmail])
  @@index([unassignedAt])
}

model DirectoryGroup {
  id          String   @id @default(uuid())
  name        String
  email       String?
  description String?
  type        String?
  scope       String?  @default("Internal Only")
  ouPath      String?
  managedBy   String?
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships DirectoryMembership[]

  @@index([name])
}

model DirectoryMembership {
  userId  String
  groupId String
  user    DirectoryUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   DirectoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

enum VlanStatus {
  ACTIVE
  RESERVED
  DEPRECATED
}

model VLAN {
  id          String     @id @default(uuid())
  vlanNumber  Int        @unique
  name        String
  description String?
  status      VlanStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  subnets     Subnet[]
  ipAddresses IPAddress[]
  switchPorts SwitchPort[]

  @@index([vlanNumber])
  @@index([name])
}

model Subnet {
  id               String   @id @default(uuid())
  cidr             String   @unique
  name             String
  vlanId           String?
  gateway          String?
  networkAddress   String?
  netmask          String?
  broadcastAddress String?
  startIp          String?
  endIp            String?
  totalIps         Int      @default(254)
  usedIps          Int      @default(0)
  reservedIps      Int      @default(0)
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vlan        VLAN?       @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  ipAddresses IPAddress[]

  @@index([vlanId])
  @@index([cidr])
  @@index([name])
}

model IPAddress {
  id             String    @id @default(uuid())
  address        String
  macAddress     String?
  vendor         String?
  deviceType     String?   @default("Workstation")
  model          String?
  serialNumber   String?
  section        String?
  floor          String?
  subnetId       String?
  vlanId         String?
  assetId        String?
  assignedUserId String?
  status         IPStatus  @default(AVAILABLE)
  pingStatus     String?   @default("online")
  responseTimeMs Float?
  lastSeen       DateTime?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subnet       Subnet?            @relation(fields: [subnetId], references: [id], onDelete: SetNull)
  vlan         VLAN?              @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  asset        Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignedUser DirectoryUser?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  managementSwitches NetworkSwitch[] @relation("SwitchManagementIP")
  switchPorts        SwitchPort[]    @relation("PortIPAddress")

  @@unique([address, subnetId])
  @@index([subnetId])
  @@index([vlanId])
  @@index([assetId])
  @@index([assignedUserId])
  @@index([status])
  @@index([pingStatus])
  @@index([macAddress])
  @@index([deviceType])
}

// ==========================================
// NETWORK RACK & SWITCH MANAGEMENT ENUMS
// ==========================================

enum RackStatus {
  ACTIVE
  PLANNED
  MAINTENANCE
  RETIRED
}

enum SwitchRole {
  CORE
  DISTRIBUTION
  ACCESS
  TOR
}

enum SwitchStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum PortFormFactor {
  RJ45_1G
  SFP_1G
  SFP_PLUS_10G
  SFP28_25G
  QSFP_PLUS_40G
  QSFP28_100G
}

enum PortAdminStatus {
  UP
  DOWN
}

enum PortOperStatus {
  ACTIVE
  DOWN
  CONNECTED_NO_SIGNAL
  RESERVED
}

enum PortMode {
  ACCESS
  TRUNK
  LACP
}

// ==========================================
// NETWORK RACK & SWITCH MANAGEMENT MODELS
// ==========================================

model NetworkRack {
  id          String     @id @default(uuid())
  name        String
  code        String     @unique
  totalHeight Int        @default(42) // 12, 24, 42, 48 RU
  depth       Float?     // mm (e.g. 1000, 1070)
  width       Float?     // mm (e.g. 600, 800)
  maxPowerKw  Float?     // kW capacity (e.g. 5.0, 7.5, 10.0)
  maxWeightKg Float?     // kg capacity (e.g. 1000)
  status      RackStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  switches NetworkSwitch[]

  @@index([code])
  @@index([name])
  @@index([status])
}

model NetworkSwitch {
  id              String       @id @default(uuid())
  name            String
  model           String
  vendor          String       // Cisco, Alcatel-Lucent, Juniper, Aruba, Mikrotik
  serialNumber    String?      @unique
  macAddress      String?
  ipAddressId     String?
  firmwareVersion String?
  role            SwitchRole   @default(ACCESS)
  status          SwitchStatus @default(ONLINE)
  totalPorts      Int          @default(24) // 2..48 even
  uplinkPorts     Int?         @default(2)  // 0-8 dedicated RJ45 uplinks
  fiberPorts      Int?         @default(2)  // 0-8 dedicated optical SFP/SFP+ ports
  rackId          String?
  rackPosition    Int?         // 1-48 RU starting slot
  rackHeight      Int          @default(1)  // RU occupied (1, 2, 4)
  assetId         String?      @unique
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  rack      NetworkRack? @relation(fields: [rackId], references: [id], onDelete: SetNull)
  asset     Asset?       @relation("SwitchAsset", fields: [assetId], references: [id], onDelete: SetNull)
  ipAddress IPAddress?   @relation("SwitchManagementIP", fields: [ipAddressId], references: [id], onDelete: SetNull)
  ports     SwitchPort[]

  @@index([rackId])
  @@index([assetId])
  @@index([ipAddressId])
  @@index([role])
  @@index([status])
  @@index([vendor])
  @@index([name])
  @@index([model])
}

model SwitchPort {
  id               String          @id @default(uuid())
  switchId         String
  portNumber       Int             // 1..48, 52
  name             String          // Gi1/0/1, Te1/0/49, port1
  formFactor       PortFormFactor  @default(RJ45_1G)
  poeEnabled       Boolean         @default(false)
  adminStatus      PortAdminStatus @default(UP)
  operStatus       PortOperStatus  @default(DOWN)
  speed            String?         // 1 Gbps, 10 Gbps, Auto
  duplex           String?         // Full, Half, Auto
  vlanId           String?
  mode             PortMode        @default(ACCESS)
  taggedVlanIds    Json?           // Array of VLAN numbers/IDs for trunk
  ipAddressId      String?
  connectedAssetId String?
  description      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  switch         NetworkSwitch @relation(fields: [switchId], references: [id], onDelete: Cascade)
  vlan           VLAN?         @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  ipAddress      IPAddress?    @relation("PortIPAddress", fields: [ipAddressId], references: [id], onDelete: SetNull)
  connectedAsset Asset?        @relation("ConnectedAssetPorts", fields: [connectedAssetId], references: [id], onDelete: SetNull)

  @@unique([switchId, portNumber])
  @@index([switchId])
  @@index([vlanId])
  @@index([ipAddressId])
  @@index([connectedAssetId])
  @@index([adminStatus])
  @@index([operStatus])
  @@index([mode])
  @@index([portNumber])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  userName    String?
  action      String
  severity    String   @default("Info")
  entity      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  status      String   @default("Success")
  details     String?
  diffPayload Json?
  oldValue    Json?
  newValue    Json?
  userAgent   String?
  hash        String?
  statusCode  Int?     @default(200)
  durationMs  Float?
  timestamp   DateTime @default(now())

  user AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([timestamp(sort: Desc)])
  @@index([entity])
  @@index([action])
  @@index([severity])
  @@index([ipAddress])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  device    String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  group       String
  description String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model ReportSchedule {
  id         String   @id @default(uuid())
  title      String
  category   String
  frequency  String
  format     String   @default("PDF")
  recipients String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([frequency])
  @@index([category])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  taxId     String?
  email     String?
  phone     String?
  address   String?
  website   String?
  status    String   @default("ACTIVE")
  parentId  String?
  parent    Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Organization[] @relation("OrganizationHierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  users       DirectoryUser[]

  @@index([parentId])
}

model Department {
  id             String        @id @default(uuid())
  name           String
  code           String        @unique
  description    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[]  @relation("DepartmentHierarchy")
  managerName    String?
  managerEmail   String?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  positions Position[]
  users     DirectoryUser[]
  assets    Asset[]

  @@index([organizationId])
  @@index([parentId])
}

model Position {
  id           String      @id @default(uuid())
  title        String
  code         String      @unique
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  level        String?     @default("Mid")
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users DirectoryUser[]

  @@index([departmentId])
}

model Vendor {
  id           String    @id @default(uuid())
  name         String
  contactEmail String?
  contactPhone String?
  website      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  licenses License[]
  assets   Asset[]

  @@index([name])
}
