generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
  LOST
}

enum LicenseType {
  SUBSCRIPTION
  PERPETUAL
  OPEN_SOURCE
  VOLUME
  OEM
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  EXPIRING_SOON
  REVOKED
}

enum IPStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
  SUSPENDED
}

enum DirectorySource {
  LOCAL
  LDAP
  AZURE_AD
}

enum NotificationType {
  INFO
  WARNING
  ALERT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model AppUser {
  id                 String     @id @default(uuid())
  username           String     @unique
  email              String     @unique
  passwordHash       String
  firstName          String
  lastName           String
  displayName        String?
  avatar             String?
  phone              String?
  roleId             String?
  status             UserStatus @default(ACTIVE)
  isLocked           Boolean    @default(false)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  role          Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status])
  @@index([roleId])
  @@index([email])
  @@index([username])
}

model DirectoryUser {
  id               String          @id @default(uuid())
  employeeCode     String?         @unique
  email            String          @unique
  firstName        String
  lastName         String
  displayName      String?
  phone            String?
  avatar           String?
  ouPath           String?
  managerName      String?
  status           AccountStatus   @default(ACTIVE)
  source           DirectorySource @default(LOCAL)
  accountExpiresAt DateTime?
  departmentId     String?
  positionId       String?
  organizationId   String?
  locationId       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization       Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position           Position?             @relation(fields: [positionId], references: [id], onDelete: SetNull)
  location           Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedAssets     Asset[]               @relation("DirectoryAssignedAssets")
  licenseAssignments LicenseAssignment[]
  groupMemberships   DirectoryMembership[]
  assignedIPs        IPAddress[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([positionId])
  @@index([locationId])
  @@index([status])
  @@index([employeeCode])
  @@index([email])
  @@index([firstName, lastName])
  @@index([ouPath])
  @@index([managerName])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       AppUser[]
  permissions RolePermission[]
}

model Permission {
  id         String           @id @default(uuid())
  action     String
  subject    String
  conditions Json?
  roles      RolePermission[]

  @@unique([action, subject])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Asset {
  id             String      @id @default(uuid())
  assetTag       String      @unique
  name           String
  description    String?
  categoryId     String?
  status         AssetStatus @default(AVAILABLE)
  serialNumber   String?
  model          String?
  manufacturer   String?
  vendorId       String?
  purchaseDate   DateTime?
  purchaseCost   Float?
  warrantyExpiry DateTime?
  assignedToId   String?
  departmentId   String?
  locationId     String?
  specs          Json?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  category    AssetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo  DirectoryUser?     @relation("DirectoryAssignedAssets", fields: [assignedToId], references: [id], onDelete: SetNull)
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location    Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vendorRef   Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  ipAddresses IPAddress[]

  @@index([assignedToId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([locationId])
  @@index([vendorId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([warrantyExpiry])
  @@index([assetTag])
  @@index([name])
  @@index([model])
  @@index([serialNumber])
}

model AssetCategory {
  id          String          @id @default(uuid())
  name        String
  description String?
  parentId    String?
  parent      AssetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    AssetCategory[] @relation("CategoryHierarchy")
  assets      Asset[]

  @@index([parentId])
}

model InventoryCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items InventoryItem[]
}

model InventoryItem {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  categoryId   String
  quantity     Int      @default(0)
  minThreshold Int      @default(5)
  unitCost     Float    @default(0)
  locationId   String?
  binNumber    String?
  supplier     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  location Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([sku])
  @@index([categoryId])
  @@index([locationId])
  @@index([quantity])
  @@index([name])
  @@index([supplier])
}

model License {
  id           String        @id @default(uuid())
  name         String
  vendor       String?
  vendorId     String?
  licenseKey   String?
  type         LicenseType   @default(SUBSCRIPTION)
  totalSeats   Int
  usedSeats    Int           @default(0)
  costPerSeat  Float         @default(0)
  purchaseDate DateTime?
  expiryDate   DateTime?
  cost         Float?
  status       LicenseStatus @default(ACTIVE)
  autoRenew    Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vendorRef   Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assignments LicenseAssignment[]

  @@index([status])
  @@index([expiryDate])
  @@index([vendor])
  @@index([vendorId])
  @@index([name])
}

model LicenseAssignment {
  id            String         @id @default(uuid())
  licenseId     String
  userId        String?
  assignedName  String?
  assignedEmail String?
  department    String?
  assignedAt    DateTime       @default(now())
  unassignedAt  DateTime?
  license       License        @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user          DirectoryUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@index([userId])
  @@index([assignedEmail])
  @@index([unassignedAt])
}

model DirectoryGroup {
  id          String   @id @default(uuid())
  name        String
  email       String?
  description String?
  type        String?
  scope       String?  @default("Internal Only")
  ouPath      String?
  managedBy   String?
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships DirectoryMembership[]

  @@index([name])
}

model DirectoryMembership {
  userId  String
  groupId String
  user    DirectoryUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   DirectoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

enum VlanStatus {
  ACTIVE
  RESERVED
  DEPRECATED
}

model VLAN {
  id          String     @id @default(uuid())
  vlanNumber  Int        @unique
  name        String
  description String?
  status      VlanStatus @default(ACTIVE)
  locationId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  location    Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  subnets     Subnet[]
  ipAddresses IPAddress[]

  @@index([locationId])
  @@index([vlanNumber])
  @@index([name])
}

model Subnet {
  id               String   @id @default(uuid())
  cidr             String   @unique
  name             String
  vlanId           String?
  locationId       String?
  gateway          String?
  networkAddress   String?
  netmask          String?
  broadcastAddress String?
  startIp          String?
  endIp            String?
  totalIps         Int      @default(254)
  usedIps          Int      @default(0)
  reservedIps      Int      @default(0)
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vlan        VLAN?       @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  location    Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ipAddresses IPAddress[]

  @@index([vlanId])
  @@index([locationId])
  @@index([cidr])
  @@index([name])
}

model IPAddress {
  id             String    @id @default(uuid())
  address        String
  hostname       String?
  macAddress     String?
  vendor         String?
  deviceType     String?   @default("Workstation")
  model          String?
  serialNumber   String?
  section        String?
  floor          String?
  subnetId       String?
  vlanId         String?
  locationId     String?
  assetId        String?
  assignedUserId String?
  status         IPStatus  @default(AVAILABLE)
  pingStatus     String?   @default("online")
  responseTimeMs Float?
  lastSeen       DateTime?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subnet       Subnet?            @relation(fields: [subnetId], references: [id], onDelete: SetNull)
  vlan         VLAN?              @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  asset        Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignedUser DirectoryUser?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([address, subnetId])
  @@index([subnetId])
  @@index([vlanId])
  @@index([locationId])
  @@index([assetId])
  @@index([assignedUserId])
  @@index([status])
  @@index([pingStatus])
  @@index([macAddress])
  @@index([hostname])
  @@index([deviceType])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  userName    String?
  action      String
  severity    String   @default("Info")
  entity      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  status      String   @default("Success")
  details     String?
  diffPayload Json?
  oldValue    Json?
  newValue    Json?
  userAgent   String?
  hash        String?
  statusCode  Int?     @default(200)
  durationMs  Float?
  timestamp   DateTime @default(now())

  user AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([timestamp(sort: Desc)])
  @@index([entity])
  @@index([action])
  @@index([severity])
  @@index([ipAddress])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  device    String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  group       String
  description String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model ReportSchedule {
  id         String   @id @default(uuid())
  title      String
  category   String
  frequency  String
  format     String   @default("PDF")
  recipients String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([frequency])
  @@index([category])
}

enum LocationType {
  CAMPUS
  SITE
  BRANCH
  BUILDING
  WORKSHOP
  WAREHOUSE
  FLOOR
  ZONE
  LINE
  AREA
  ROOM
  RACK
  SHELF
  STATION
  BIN
}

model Location {
  id             String        @id @default(uuid())
  name           String
  code           String?
  description    String?
  type           LocationType  @default(CAMPUS)
  status         String        @default("ACTIVE")
  building       String?
  floor          String?
  room           String?
  address        String?
  parentId       String?
  parent         Location?     @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Location[]    @relation("LocationHierarchy")
  fullPath       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assets         Asset[]
  users          DirectoryUser[]
  vlans          VLAN[]
  subnets        Subnet[]
  ipAddresses    IPAddress[]
  inventoryItems InventoryItem[]

  @@index([organizationId])
  @@index([parentId])
  @@index([type])
  @@index([status])
  @@index([name])
  @@index([code])
}


model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  taxId     String?
  email     String?
  phone     String?
  address   String?
  website   String?
  status    String   @default("ACTIVE")
  parentId  String?
  parent    Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Organization[] @relation("OrganizationHierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  locations   Location[]
  users       DirectoryUser[]

  @@index([parentId])
}

model Department {
  id             String        @id @default(uuid())
  name           String
  code           String        @unique
  description    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[]  @relation("DepartmentHierarchy")
  managerName    String?
  managerEmail   String?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  positions Position[]
  users     DirectoryUser[]
  assets    Asset[]

  @@index([organizationId])
  @@index([parentId])
}

model Position {
  id           String      @id @default(uuid())
  title        String
  code         String      @unique
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  level        String?     @default("Mid")
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users DirectoryUser[]

  @@index([departmentId])
}

model Vendor {
  id           String    @id @default(uuid())
  name         String
  contactEmail String?
  contactPhone String?
  website      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  licenses License[]
  assets   Asset[]

  @@index([name])
}
