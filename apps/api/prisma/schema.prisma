generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
  LOST
}

enum LicenseType {
  SUBSCRIPTION
  PERPETUAL
  OPEN_SOURCE
  VOLUME
  OEM
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  EXPIRING_SOON
  REVOKED
}

enum IPStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
  SUSPENDED
}

enum DirectorySource {
  LOCAL
  LDAP
  AZURE_AD
}

enum NotificationType {
  INFO
  WARNING
  ALERT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  email              String              @unique
  passwordHash       String
  firstName          String
  lastName           String
  displayName        String?
  jobTitle           String?
  roleId             String?
  roleName           String?             @default("Employee")
  status             UserStatus          @default(ACTIVE)
  source             DirectorySource     @default(LOCAL)
  avatar             String?
  phone              String?
  department         String?
  location           String?
  adInitialPassword  String?
  departmentId       String?
  positionId         String?
  organizationId     String?
  locationId         String?
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  role               Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  departmentRel      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionRel        Position?           @relation(fields: [positionId], references: [id], onDelete: SetNull)
  locationRel        Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedAssets     Asset[]             @relation("AssignedAssets")
  licenseAssignments LicenseAssignment[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  groupMemberships   DirectoryMembership[]

  @@index([status])
  @@index([department])
  @@index([roleName])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id         String           @id @default(uuid())
  action     String
  subject    String
  conditions Json?
  roles      RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Asset {
  id             String      @id @default(uuid())
  assetTag       String      @unique
  name           String
  description    String?
  categoryId     String?
  status         AssetStatus @default(AVAILABLE)
  serialNumber   String?
  model          String?
  manufacturer   String?
  purchaseDate   DateTime?
  purchaseCost   Float?
  warrantyExpiry DateTime?
  assignedToId   String?
  locationId     String?
  specs          Json?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  category   AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("AssignedAssets", fields: [assignedToId], references: [id], onDelete: SetNull)
  location   Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  history    AssetHistory[]

  @@index([assignedToId])
  @@index([categoryId])
  @@index([locationId])
  @@index([status])
  @@index([assetTag])
}

model AssetCategory {
  id          String          @id @default(uuid())
  name        String
  description String?
  parentId    String?
  parent      AssetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    AssetCategory[] @relation("CategoryHierarchy")
  assets      Asset[]
}

model AssetHistory {
  id        String   @id @default(uuid())
  assetId   String
  action    String
  changedBy String
  oldValue  Json?
  newValue  Json?
  timestamp DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([timestamp(sort: Desc)])
}

model InventoryItem {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  category     String
  quantity     Int      @default(0)
  minThreshold Int      @default(5)
  unitCost     Float    @default(0)
  location     String
  binNumber    String?
  supplier     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sku])
  @@index([category])
  @@index([quantity])
}

model License {
  id           String        @id @default(uuid())
  name         String
  vendor       String?
  licenseKey   String?
  type         LicenseType   @default(SUBSCRIPTION)
  totalSeats   Int
  usedSeats    Int           @default(0)
  costPerSeat  Float         @default(0)
  purchaseDate DateTime?
  expiryDate   DateTime?
  cost         Float?
  status       LicenseStatus @default(ACTIVE)
  autoRenew    Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignments LicenseAssignment[]

  @@index([status])
  @@index([vendor])
}

model LicenseAssignment {
  id            String    @id @default(uuid())
  licenseId     String
  userId        String?
  assignedName  String?
  assignedEmail String?
  department    String?
  assignedAt    DateTime  @default(now())
  unassignedAt  DateTime?
  license       License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@index([userId])
  @@index([assignedEmail])
}

model DirectoryGroup {
  id          String                @id @default(uuid())
  name        String
  email       String?
  description String?
  type        String?
  scope       String?               @default("Internal Only")
  managedBy   String?
  memberCount Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  memberships DirectoryMembership[]
}

model DirectoryMembership {
  userId  String
  groupId String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   DirectoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model IPAddress {
  id          String   @id @default(uuid())
  address     String   @unique
  hostname    String?
  macAddress  String?
  vendor      String?
  deviceType  String?  @default("Workstation")
  subnetId    String?
  subnetName  String?
  vlanName    String?
  status      IPStatus @default(AVAILABLE)
  pingStatus  String?  @default("online")
  lastSeen    String?
  assignedTo  String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subnet Subnet? @relation(fields: [subnetId], references: [id], onDelete: SetNull)

  @@index([subnetId])
  @@index([status])
}

model Subnet {
  id          String   @id @default(uuid())
  cidr        String   @unique
  name        String
  vlanId      String?
  vlanName    String?
  gateway     String?
  totalIps    Int      @default(254)
  usedIps     Int      @default(0)
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vlan        VLAN?       @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  ipAddresses IPAddress[]
}

model VLAN {
  id          String   @id @default(uuid())
  vlanNumber  Int      @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subnets Subnet[]
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  userName    String?
  action      String
  severity    String   @default("Info")
  entity      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  status      String   @default("Success")
  details     String?
  diffPayload Json?
  oldValue    Json?
  newValue    Json?
  userAgent   String?
  timestamp   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([timestamp(sort: Desc)])
  @@index([entity])
  @@index([action])
  @@index([severity])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  group       String
  description String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model ReportSchedule {
  id         String   @id @default(uuid())
  title      String
  category   String
  frequency  String
  format     String   @default("PDF")
  recipients String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Location {
  id             String        @id @default(uuid())
  name           String
  code           String?
  building       String?
  floor          String?
  room           String?
  address        String?
  type           String?       @default("Branch Office")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assets Asset[]
  users  User[]

  @@index([organizationId])
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  taxId       String?
  email       String?
  phone       String?
  address     String?
  website     String?
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  departments Department[]
  locations   Location[]
  users       User[]
}

model Department {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[] @relation("DepartmentHierarchy")
  managerName    String?
  managerEmail   String?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  positions      Position[]
  users          User[]

  @@index([organizationId])
  @@index([parentId])
}

model Position {
  id           String      @id @default(uuid())
  title        String
  code         String      @unique
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  level        String?     @default("Mid")
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users        User[]

  @@index([departmentId])
}

model Vendor {
  id           String   @id @default(uuid())
  name         String
  contactEmail String?
  contactPhone String?
  website      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
